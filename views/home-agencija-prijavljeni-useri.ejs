<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista putovanja</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
      body {
        background-color: #f8f5f0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        padding: 16px 40px;
      }

      .navbar-brand {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #1a1a1a !important;
      }

      .navbar-brand span {
        color: #c8a96e;
      }

      .page-header {
        padding: 40px;
        background-color: #fff;
        border-bottom: 1px solid #e0e0e0;
      }

      .page-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
      }

      .content {
        padding: 40px;
      }

      .table-wrap {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        overflow: hidden;
      }

      .table {
        margin: 0;
      }

      .table thead {
        background-color: #f8f5f0;
      }

      .table thead th {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        font-weight: 600;
        padding: 16px 20px;
        border: none;
      }

      .table tbody td {
        padding: 16px 20px;
        font-size: 14px;
        color: #1a1a1a;
        vertical-align: middle;
        border-color: #f0f0f0;
      }

      .table tbody tr:hover {
        background-color: #fafaf8;
      }

      .badge-agencija {
        background-color: #f8f5f0;
        color: #c8a96e;
        border: 1px solid #c8a96e;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 500;
      }

      .btn-obrisi {
        background-color: transparent;
        border: 1px solid #2ecc71;
        color: 50e73c;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        transition: all 0.2s;
      }

      .btn-obrisi:hover {
        background-color: #2ecc71;
        color: #fff;
      }
    </style>
  </head>
  <body>

    <nav class="navbar d-flex justify-content-between align-items-center">
      <div class="navbar-brand">TERRA<span>VISTA</span></div>
      <a href="/home-agencija" style="border: 1px solid #ddd; color:#888; border-radius:8px; padding:8px 18px; font-size:14px; text-decoration:none;">
        <i class="bi bi-arrow-left me-1"></i> Nazad
      </a>
    </nav>

    <div class="page-header">
      <h1><i class="bi bi-globe2 me-2" style="color:#c8a96e;"></i> Lista putovanja</h1>
    </div>

    <div class="content">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Ime</th>
              <th>Prezime</th>
              <th>E-mail</th>
              <th>Drzava</th>
              <th>Grad</th>
              <th>Datum</th>
              <th>Status</th>
              <th>Akcija</th>
            </tr>
          </thead>
          <tbody>
            <% podaci.forEach((podatak) => { %>
            <tr>
              <td><span class="badge-agencija"><%= podatak.ime %></span></td>
              <td><%= podatak.prezime %></td>
              <td><%= podatak.email %></td>
              <td><%= podatak.drzava %></td>
              <td><%= podatak.grad %></td>
              <td><i class="bi bi-calendar3 me-1" style="color:#c8a96e;"></i><%= podatak.datum %></td>
              <td><%= podatak.aktivan %></td>
              <td>
                    <% if(podatak.aktivan == 0) {%>
                      <form action="/home-agencija/prijavljeni-useri/odobreno" method="POST">
                      <input type="hidden" name="id" value="<%= podatak.id %>">
                      <button type="submit" class="btn-obrisi">
                      <i class="bi bi-patch-check-fill"></i><strong>Odobri</strong>
                      </button>
                      </form>
                    <%}else{%>
                      <button type="submit" class="btn-obrisi">
                      <i class="bi bi-ban"></i><strong>Blokiraj</strong>
                    </button>
                    <%}%>
                  </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>