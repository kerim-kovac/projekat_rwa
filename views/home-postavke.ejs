<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Postavke</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
      body {
        background-color: #f8f5f0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        padding: 16px 40px;
      }

      .navbar-brand {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #1a1a1a !important;
      }

      .navbar-brand span {
        color: #c8a96e;
      }

      .content {
        padding: 50px 40px;
        max-width: 700px;
        margin: 0 auto;
      }

      .profil-kartica {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        padding: 30px;
        margin-bottom: 30px;
      }

      .profil-kartica h5 {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 16px;
        font-weight: 600;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 15px;
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .info-label {
        color: #888;
        font-size: 13px;
      }

      .info-value {
        color: #1a1a1a;
        font-weight: 500;
      }

      .forma-kartica {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        padding: 30px;
        margin-bottom: 30px;
      }

      .forma-kartica h5 {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 20px;
        font-weight: 600;
      }

      label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 6px;
      }

      .form-control {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 15px;
        color: #1a1a1a;
        background-color: #fafafa;
        transition: border-color 0.2s;
      }

      .form-control:focus {
        border-color: #c8a96e;
        box-shadow: none;
        background-color: #fff;
      }

      .btn-submit {
        background-color: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-size: 14px;
        font-weight: 500;
        transition: background-color 0.2s;
      }

      .btn-submit:hover {
        background-color: #333;
        color: #fff;
      }

      .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 30px;
      }
    </style>
  </head>
  <body>

    <nav class="navbar d-flex justify-content-between align-items-center">
      <div class="navbar-brand">TERRA<span>VISTA</span></div>
      <a href="/home" style="border: 1px solid #ddd; color:#888; border-radius:8px; padding:8px 18px; font-size:14px; text-decoration:none;">
        <i class="bi bi-arrow-left me-1"></i> Nazad
      </a>
    </nav>

    <div class="content">
      <h1 class="page-title"><i class="bi bi-gear me-2" style="color:#c8a96e;"></i> Postavke</h1>

      <!-- INFO KARTICA -->
      <div class="profil-kartica">
        <h5><i class="bi bi-person me-1"></i> Vaši podaci</h5>
        <div class="info-row">
          <span class="info-label">Ime</span>
          <span class="info-value"><%= korisnik.ime %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Prezime</span>
          <span class="info-value"><%= korisnik.prezime %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Username</span>
          <span class="info-value"><%= korisnik.username %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Email</span>
          <span class="info-value"><%= korisnik.email %></span>
        </div>
      </div>

      <!-- PROMJENA IMENA -->
      <div class="forma-kartica">
        <h5><i class="bi bi-pencil me-1"></i> Promjena imena i prezimena</h5>
        <form action="/home/postavke/promjena-imena-prezimena" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label>Novo ime</label>
              <input type="text" class="form-control" placeholder="Unesite novo ime" name="novoIme">
            </div>
            <div class="col-6">
              <label>Novo prezime</label>
              <input type="text" class="form-control" placeholder="Unesite novo prezime" name="novoPrezime">
            </div>
          </div>
          <button type="submit" class="btn-submit">
            <i class="bi bi-check2 me-1"></i> Promjeni
          </button>
        </form>
      </div>

      <!-- PROMJENA SIFRE -->
      <div class="forma-kartica">
        <h5><i class="bi bi-lock me-1"></i> Promjena lozinke</h5>
        <form action="/home/postavke/promjena-sifre" method="POST">
          <div class="mb-3">
            <label>Trenutna lozinka</label>
            <input type="password" class="form-control" placeholder="Unesite trenutnu lozinku" name="trenutna">
          </div>
          <div class="mb-3">
            <label>Nova lozinka</label>
            <input type="password" class="form-control" placeholder="Unesite novu lozinku" name="nova">
          </div>
          <button type="submit" class="btn-submit">
            <i class="bi bi-check2 me-1"></i> Promjeni
          </button>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>