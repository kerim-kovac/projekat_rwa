<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Agencije</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
      body {
        background-color: #f8f5f0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        padding: 16px 40px;
      }

      .navbar-brand {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #1a1a1a !important;
      }

      .navbar-brand span {
        color: #c8a96e;
      }

      .hero {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
          url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1400') center/cover no-repeat;
        padding: 100px 40px;
        color: #fff;
      }

      .hero h1 {
        font-size: 40px;
        font-weight: 700;
        margin-bottom: 8px;
      }

      .hero p {
        font-size: 16px;
        opacity: 0.8;
      }

      .role-badge {
        display: inline-block;
        background-color: rgba(200, 169, 110, 0.3);
        color: #c8a96e;
        border: 1px solid #c8a96e;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 13px;
        margin-top: 10px;
      }

      .kartice {
        padding: 60px 40px;
      }

      .kartica {
        background-color: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        padding: 36px 30px;
        transition: all 0.2s;
        text-decoration: none;
        display: block;
        color: #1a1a1a;
        height: 100%;
      }

      .kartica:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        color: #1a1a1a;
      }

      .kartica-icon {
        width: 50px;
        height: 50px;
        background-color: #f8f5f0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #c8a96e;
        margin-bottom: 20px;
      }

      .kartica h3 {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .kartica p {
        font-size: 14px;
        color: #888;
        margin: 0;
      }
    </style>
  </head>
  <body>

    <nav class="navbar d-flex justify-content-between align-items-center">
      <div class="navbar-brand">TERRA<span>VISTA</span></div>
      <a href="/home-agencija/logout" style="border: 1px solid #ddd; color:#888; border-radius:8px; padding:8px 18px; font-size:14px; text-decoration:none;">
        <i class="bi bi-box-arrow-right me-1"></i> Logout
      </a>
    </nav>

    <div class="hero">
      <div class="container">
        <h1>Dobrodošli, <%= agencija.naziv %>!</h1>
        <p>Upravljajte vašim putovanjima i korisnicima na jednom mjestu.</p>
        <div class="role-badge"><i class="bi bi-shield-check me-1"></i> <%= agencija.role %></div>
      </div>
    </div>

    <div class="kartice">
      <div class="container">
        <div class="row g-4">

          <div class="col-md-3">
            <a href="/home-agencija/kreiraj-putovanje" class="kartica">
              <div class="kartica-icon">
                <i class="bi bi-plus-circle"></i>
              </div>
              <h3>Kreiraj putovanje</h3>
              <p>Dodajte novo putovanje i ponudite ga korisnicima.</p>
            </a>
          </div>

          <div class="col-md-3">
            <a href="/home-agencija/lista-putovanja" class="kartica">
              <div class="kartica-icon">
                <i class="bi bi-globe2"></i>
              </div>
              <h3>Lista putovanja</h3>
              <p>Pregledajte i upravljajte svim vašim putovanjima.</p>
            </a>
          </div>

          <div class="col-md-3">
            <a href="/home-agencija/prijavljeni-useri" class="kartica">
              <div class="kartica-icon">
                <i class="bi bi-people"></i>
              </div>
              <h3>Prijavljeni korisnici</h3>
              <p>Pregledajte korisnike prijavljene na vaša putovanja.</p>
            </a>
          </div>

          <div class="col-md-3">
            <a href="/home-agencija/postavke" class="kartica">
              <div class="kartica-icon">
                <i class="bi bi-gear"></i>
              </div>
              <h3>Opcije</h3>
              <p>Uredite podatke vaše agencije i postavke naloga.</p>
            </a>
          </div>

        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>