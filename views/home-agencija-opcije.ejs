<!DOCTYPE html>
<html>
  <head>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <h1><%= agencija.naziv %></h1>
    <h1><%= agencija.email %></h1>
    <h1><%= agencija.datum %></h1>
      <h1>ovde cete moci promjeniti sifru;:</h1>
    <form action="/home-agencija/postavke/promjena-sifre" method="POST">
      <h1>Unesite trenutnu sifru;</h1>
      <input type="text" placeholder="Unesite vasu trenutnu sifru" name="trenutna">
      <h1>Unesite novu sifru: </h1>
      <input type="text" placeholder="nova" name="nova">
      <button type="submit">Promjeni</button>
    </form>
  </body>
</html>
