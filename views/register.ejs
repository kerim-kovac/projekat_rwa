<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registracija</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
      body {
        background-color: #f8f5f0;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 50px 40px;
        max-width: 500px;
        width: 100%;
        background-color: #ffffff;
      }

      .logo-text {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #1a1a1a;
      }

      .logo-text span {
        color: #c8a96e;
      }

      h1 {
        font-size: 26px;
        font-weight: 600;
        color: #1a1a1a;
      }

      p {
        color: #888;
        font-size: 15px;
      }

      .btn-agencija {
        background-color: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-size: 15px;
        font-weight: 500;
        width: 100%;
        transition: background-color 0.2s;
      }

      .btn-agencija:hover {
        background-color: #333;
        color: #fff;
      }

      .btn-korisnik {
        background-color: #fff;
        color: #1a1a1a;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 14px;
        font-size: 15px;
        font-weight: 500;
        width: 100%;
        transition: all 0.2s;
      }

      .btn-korisnik:hover {
        border-color: #c8a96e;
        color: #c8a96e;
      }

      .divider {
        height: 1px;
        background-color: #f0f0f0;
        margin: 24px 0;
      }
    </style>
  </head>
  <body>

    <div class="card">
      <div class="text-center mb-4">
        <div class="logo-text mb-3">TERRA<span>VISTA</span></div>
        <h1>Dobrodošli</h1>
        <p>Odaberite tip registracije da biste nastavili</p>
      </div>

      <div class="divider"></div>

      <div class="d-flex flex-column gap-3">
        <a href="/register/agencija" class="text-decoration-none">
          <button class="btn-agencija">
            <i class="bi bi-building me-2"></i> Registruj agenciju
          </button>
        </a>

        <a href="/register/korisnik" class="text-decoration-none">
          <button class="btn-korisnik">
            <i class="bi bi-person me-2"></i> Registruj korisnika
          </button>
        </a>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>