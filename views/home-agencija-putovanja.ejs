<!DOCTYPE html>
<html>
  <head>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <h1>Kreirajte putovanje</h1>
    <form action="/home-agencija/kreiraj-putovanje" method="POST">
    <h1>DRZAVA</h1>
    <input type="text" name="drzava">
    <h1>GRAD</h1>
    <input type="text" name="grad">
    <h1>DESKRIPCIJA</h1>
    <input type="text" name="deskripcija">
    <h1>DATUM</h1>
    <input type="date" name="datum">
    <h1>MINIMALAN BROJ LJUDI</h1>
    <input type="number" name="minimalan">
    <h1>MAXIMALAN BROJ LJUDI</h1>
    <input type="number" name="maximalan">
    <h1>CIJENA</h1>
    <input type="number" name="cijena">
    <button type="submit">KREIRAJ PUTOVANJE</button>  
    </form>
  </body>
</html>
