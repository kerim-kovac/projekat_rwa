<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moje rezervacije</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background-color: #f8f5f0;
      font-family: 'Segoe UI', sans-serif;
    }

    .navbar {
      background-color: #ffffff;
      border-bottom: 1px solid #e0e0e0;
      padding: 16px 40px;
    }

    .navbar-brand {
      font-size: 20px;
      font-weight: 700;
      color: #1a1a1a !important;
    }

    .navbar-brand span {
      color: #c8a96e;
    }

    .page-header {
      padding: 40px;
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
    }

    .page-header h1 {
      font-size: 28px;
      font-weight: 700;
      margin: 0;
    }

    .content {
      padding: 40px;
    }

    .table-wrap {
      background: #fff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }

    .table {
      margin: 0;
    }

    .table thead {
      background: #f8f5f0;
    }

    .table thead th {
      font-size: 12px;
      text-transform: uppercase;
      color: #888;
      padding: 16px;
    }

    .table tbody td {
      padding: 16px;
      vertical-align: middle;
      font-size: 14px;
    }

    .badge-agencija {
      background: #f8f5f0;
      color: #c8a96e;
      border: 1px solid #c8a96e;
      border-radius: 20px;
      padding: 4px 10px;
      font-size: 12px;
    }

    /* STATUS */
    .status {
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 12px;
      display: inline-block;
      font-size: 13px;
    }

    .status-0 {
      background: #fff3cd;
      color: #b8860b;
    }

    .status-1 {
      background: #d4edda;
      color: #2ecc71;
    }

    .status-2 {
      background: #f8d7da;
      color: #e74c3c;
    }
  </style>
</head>

<body>

<nav class="navbar d-flex justify-content-between align-items-center">
  <div class="navbar-brand">TERRA<span>VISTA</span></div>
  <a href="/home" style="text-decoration:none; color:#888;">
    <i class="bi bi-arrow-left"></i> Nazad
  </a>
</nav>

<div class="page-header">
  <h1><i class="bi bi-globe2 me-2" style="color:#c8a96e;"></i> Moje rezervacije</h1>
</div>

<div class="content">

  <div class="table-wrap">
    <table class="table">

      <thead>
        <tr>
          <th>Država</th>
          <th>Grad</th>
          <th>Datum</th>
          <th>Cijena</th>
          <th>Status</th>
          <th>Akcija</th>
        </tr>
      </thead>

      <tbody>

        <% podaci.forEach((podatak) => { %>
        <tr>

          <td><%= podatak.drzava %></td>
          <td><%= podatak.grad %></td>
          <td><%= podatak.datum %></td>
          <td><strong><%= podatak.cijena %></strong></td>

          <td>
            <% if(podatak.aktivan == 0) { %>
              <span class="status status-0">Na čekanju</span>
            <% } else if(podatak.aktivan == 1) { %>
              <span class="status status-1">Odobreno</span>
            <% } else if(podatak.aktivan == 2) { %>
              <span class="status status-2">Odbijeno</span>
            <% } %>
          </td>
        <td>
          <form action="/home/rezervacije/odjava" method="POST">
            <input type="hidden" name="putovanjeId" value="<%= podatak.putovanje_id %> ">
            <button type="submit">Odjavi se</button>
          </form>
        </td>
        </tr>
        <% }) %>

      </tbody>

    </table>
  </div>

</div>

</body>
</html>